FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY web/package*.json web/
RUN cd web && npm ci
COPY web/ web/
COPY public/ public/
ENV VITE_REQUIRE_ACCOUNT=true
RUN cd web && npm run build
# Only the commercially filtered screening pack and aerial tiles enter this image.
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/web/dist/index.html /srv/index.html
COPY --from=build /app/web/dist/assets /srv/assets
COPY --from=build /app/web/dist/screening /srv/screening
COPY --from=build /app/web/dist/worlds/mojave-001/terrain/imagery /srv/worlds/mojave-001/terrain/imagery
